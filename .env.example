# Public port used by the Node application.
PORT=8003

# Required for password-protected CMS access. Use a long, unique password.
CMS_ADMIN_PASSWORD=change-this-to-a-long-unique-password

# Required to sign CMS session cookies. Generate at least 32 random characters.
CMS_AUTH_SECRET=replace-with-a-long-random-secret

# Legacy fallback only when CMS_ADMIN_PASSWORD and CMS_AUTH_SECRET are absent.
# Keep 127.0.0.1 and ::1 for local administration. Do not use 0.0.0.0.
CMS_ALLOWED_IPS=127.0.0.1,::1

# Set to true only when Nginx is the only public entry point and correctly sets
# X-Forwarded-For. Otherwise leave false.
TRUST_PROXY=false

# The public canonical origin used in SEO metadata.
APP_URL=http://127.0.0.1:8003
