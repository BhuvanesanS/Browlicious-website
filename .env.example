# Public port used by the Node application.
PORT=8003

# Comma-separated IP addresses that can create, edit, publish, or delete posts.
# Keep 127.0.0.1 and ::1 for local administration. Do not use 0.0.0.0.
CMS_ALLOWED_IPS=127.0.0.1,::1

# Set to true only when Nginx is the only public entry point and correctly sets
# X-Forwarded-For. Otherwise leave false.
TRUST_PROXY=false

# The public canonical origin used in SEO metadata.
APP_URL=http://127.0.0.1:8003
