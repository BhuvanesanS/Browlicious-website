{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/post.html?slug=:slug" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/testimonials", "destination": "/index.html" },
    { "source": "/academy", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/resources", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ]
}
